{
    "name": "motifjs-tests",
    "version": "4.0.0",
    "private": true,
    "type": "commonjs",
    "scripts": {
        "test": "jest --config ./jest.config.cjs",
        "test:watch": "jest --config ./jest.config.cjs --watch",
        "test:coverage": "jest --config ./jest.config.cjs --coverage",
        "test:lifecycle": "jest --config ./jest.config.cjs component.lifecycle.test",
        "test:binding": "jest --config ./jest.config.cjs component.binding.test",
        "test:stress": "jest --config ./jest.config.cjs component.stress.test",
        "test:benchmark": "jest --config ./jest.config.cjs component.benchmark.test",
        "test:memory": "node --expose-gc ../../node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand src/memory",
        "build": "",
        "dev": ""
    },
    "devDependencies": {
        "jest": "^30.1.1",
        "jest-environment-jsdom": "^30.1.1",
        "ts-jest": "^29.2.5",
        "typescript": "^5.4.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^20.0.0",
        "jsdom": "^26.1.0",
        "@types/jsdom": "^21.1.7"
    },
    "dependencies": {
        "@motifx/core": "file:../motifjs"
    }
}